{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Raphael",
  "version": "0.2.0",
  "identifier": "app.raphael.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "appDirectoriesOverride": {
      "config": "$DATA/Raphael",
      "data": "$DATA/Raphael",
      "localData": "$LOCALDATA/Raphael",
      "cache": "$LOCALDATA/Raphael/cache",
      "log": "$LOCALDATA/Raphael/logs"
    },
    "windows": [
      {
        "label": "main",
        "dragDropEnabled": false,
        "create": false,
        "title": "Raphael",
        "url": "index.html",
        "width": 1180,
        "height": 780,
        "center": true,
        "minWidth": 720,
        "minHeight": 480,
        "decorations": false,
        "resizable": true,
        "zoomHotkeysEnabled": true,
        "visible": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https:",
        "media-src": "'self' data: blob: https:",
        "frame-src": "'self' https://www.youtube-nocookie.com https://www.youtube.com",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-ancestors": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
